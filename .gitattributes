# Normalize text files in the repository so WSL/Linux development stays quiet.
* text=auto eol=lf

# Windows launchers are intended to be opened/run from Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary / generated scientific assets must not be line-ending normalized.
*.db binary
*.docx binary
*.gif binary
*.jpg binary
*.jpeg binary
*.msh binary
*.npy binary
*.npz binary
*.pdf binary
*.png binary
*.pt binary
*.pth binary
*.sqlite binary
*.zip binary

# Measurement CSV files come from hardware/export tools; preserve original bytes.
data/measurements/** -text
