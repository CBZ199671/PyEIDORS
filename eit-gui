#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PROFILE_ARG=(--cpu)
if (($# > 0)); then
  case "$1" in
    --gpu|gpu)
      PROFILE_ARG=(--gpu)
      shift
      ;;
    --cpu|cpu)
      PROFILE_ARG=(--cpu)
      shift
      ;;
  esac
fi

exec bash "$ROOT_DIR/scripts/gui/run_eit_app.sh" "${PROFILE_ARG[@]}" "$@"
