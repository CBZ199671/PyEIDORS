{
  "schemaVersion": 1,
  "backendName": "PyEIDORS",
  "backendVersion": "2.0.0",
  "protocol": "json-lines+hdf5",
  "defaultProfile": "complex64",
  "normalRuntime": "nix-run-app",
  "developmentRuntime": "nix develop .#complex64 -c eit-backend-worker serve",
  "developmentRuntimeAllowed": false,
  "profiles": {
    "default": {
      "displayName": "实值 CPU",
      "description": "CPU real-valued float64 runtime for external GUI backend calls",
      "packageAttr": "pyeidors",
      "workerApp": "eit-backend-worker-real-cpu",
      "doctorApp": "eit-backend-doctor-real-cpu",
      "workerLaunchCommand": "nix run .#eit-backend-worker-real-cpu -- serve",
      "doctorCommand": "nix run .#eit-backend-doctor-real-cpu -- --profile default --format json",
      "scalar": "real",
      "precision": "float64",
      "accelerator": "cpu",
      "requiresGpu": false,
      "requiresAmgx": false
    },
    "complex64": {
      "displayName": "复值 CPU · complex64",
      "description": "CPU complex64 runtime for external GUI backend calls",
      "packageAttr": "pyeidors-complex64",
      "workerApp": "eit-backend-worker-complex64",
      "doctorApp": "eit-backend-doctor-complex64",
      "workerLaunchCommand": "nix run .#eit-backend-worker-complex64 -- serve",
      "doctorCommand": "nix run .#eit-backend-doctor-complex64 -- --profile complex64 --format json",
      "scalar": "complex",
      "precision": "complex64",
      "accelerator": "cpu",
      "requiresGpu": false,
      "requiresAmgx": false
    },
    "complex": {
      "displayName": "复值 CPU · complex128",
      "description": "CPU complex128 runtime for external GUI backend calls",
      "packageAttr": "pyeidors-complex",
      "workerApp": "eit-backend-worker-complex128-cpu",
      "doctorApp": "eit-backend-doctor-complex128-cpu",
      "workerLaunchCommand": "nix run .#eit-backend-worker-complex128-cpu -- serve",
      "doctorCommand": "nix run .#eit-backend-doctor-complex128-cpu -- --profile complex --format json",
      "scalar": "complex",
      "precision": "complex128",
      "accelerator": "cpu",
      "requiresGpu": false,
      "requiresAmgx": false
    },
    "cuda": {
      "displayName": "实值 GPU/CUDA",
      "description": "CUDA real-valued float64 runtime for supported NVIDIA GPUs",
      "packageAttr": "pyeidors-cuda",
      "workerApp": "eit-backend-worker-real-gpu",
      "doctorApp": "eit-backend-doctor-real-gpu",
      "workerLaunchCommand": "nix run .#eit-backend-worker-real-gpu -- serve",
      "doctorCommand": "nix run .#eit-backend-doctor-real-gpu -- --profile cuda --require-gpu --format json",
      "scalar": "real",
      "precision": "float64",
      "accelerator": "cuda",
      "requiresGpu": true,
      "requiresAmgx": false,
      "cuda": {
        "toolkitVersion": "12.8.1",
        "minLinuxDriver": "570.124.06",
        "minWindowsDriver": "572.61"
      }
    },
    "cuda-amgx": {
      "displayName": "实值 GPU/CUDA · AMGX",
