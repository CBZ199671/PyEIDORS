{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyeidors.org/schemas/eidors_pyeidors_geometry_v2.schema.json",
  "title": "Logical field contract for geometry.mat (Geometry v2)",
  "description": "Array shapes and source-presence semantics are validated by pyeidors.interop.validate_exchange_payload. New writers emit explicit presence/provenance fields; readers retain compatibility with early Geometry v2 payloads where declared values were implicitly exact.",
  "type": "object",
  "required": [
    "exchange_format",
    "schema_version",
    "index_base",
    "source_framework",
    "dimension",
    "cell_type",
    "boundary_entity_type",
    "nodes",
    "elems",
    "boundary_facets",
    "electrode_nodes",
    "electrode_node_counts",
    "n_elec",
    "background",
    "truth_elem_data",
    "contact_impedance",
    "mesh_name",
    "mesh_level",
    "scenario_name"
  ],
  "properties": {
    "exchange_format": {
      "const": "eidors_pyeidors_geometry_v2"
    },
    "schema_version": {
      "const": 2
    },
    "index_base": {
      "const": 1
    },
    "source_framework": {
      "enum": [
        "eidors",
        "pyeidors"
      ]
    },
    "dimension": {
      "enum": [
        2,
        3
      ]
    },
    "cell_type": {
      "enum": [
        "triangle",
        "tetrahedron"
      ]
    },
    "boundary_entity_type": {
      "enum": [
        "edge",
        "triangle"
      ]
    },
    "nodes": {},
    "elems": {},
    "boundary_facets": {},
    "boundary_edges": {},
    "electrode_nodes": {},
    "electrode_node_counts": {},
    "electrode_faces": {},
    "electrode_face_counts": {},
    "electrode_model": {},
    "electrode_projection_required": {},
    "n_elec": {
      "type": "integer",
      "minimum": 1
    },
    "background": {},
    "background_present": {},
    "background_elem_data": {},
    "background_elem_data_present": {},
    "truth_elem_data": {},
    "truth_elem_data_present": {},
    "target_elem_data": {},
    "contact_impedance": {},
    "contact_impedance_present": {},
    "contact_impedance_unit": {},
    "mesh_name": {},
    "mesh_level": {},
    "scenario_name": {},
    "stim_matrix": {},
    "stim_matrix_raw": {},
    "meas_matrices": {},
    "measurement_counts": {},
    "volt_matrix": {},
    "volt_pattern_present": {},
    "interior_sources": {},
    "interior_source_counts": {},
    "stimulation_labels": {},
    "current_density": {},
    "current_density_present": {},
    "current_density_applied": {},
    "stim_positive_current": {},
    "stim_negative_current": {},
    "stim_net_current": {},
    "stim_max_abs_current": {},
    "stim_balanced": {},
    "stimulation_supported": {},
    "normalize_measurements": {},
    "normalize_measurements_present": {},
    "normalize_measurements_source": {},
    "gnd_node": {},
    "gnd_node_present": {},
    "effective_gnd_node": {},
    "effective_gnd_node_source": {},
    "model_solver": {},
    "effective_model_solver": {},
    "model_system_mat": {},
    "effective_model_system_mat": {},
    "model_jacobian": {},
    "model_measured_quantity": {},
    "model_coordinate_units": {},
    "model_valid": {},
    "model_validation_error": {},
    "forward_blockers": {},
    "forward_warnings": {},
    "capture_metadata_json": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dimension": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "cell_type": {
            "const": "triangle"
          },
          "boundary_entity_type": {
            "const": "edge"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dimension": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "cell_type": {
            "const": "tetrahedron"
          },
          "boundary_entity_type": {
            "const": "triangle"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
